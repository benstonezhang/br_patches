diff -ruN a/buildroot/package/Config.in b/buildroot/package/Config.in
--- a/buildroot/package/Config.in	2025-07-14 14:08:16.000000000 +0800
+++ b/buildroot/package/Config.in	2026-08-29 00:04:18.287067294 +0800
@@ -2163,6 +2163,7 @@
 	source "package/highway/Config.in"
 	source "package/ifuse/Config.in"
 	source "package/iniparser/Config.in"
+	source "package/isl/Config.in"
