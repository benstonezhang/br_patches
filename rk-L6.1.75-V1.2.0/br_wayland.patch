diff -ruN a/buildroot/package/wayland/0002-wayland-client-Support-waiting-for-socket-when-conne.patch b/buildroot/package/wayland/0002-wayland-client-Support-waiting-for-socket-when-conne.patch
--- a/buildroot/package/wayland/0002-wayland-client-Support-waiting-for-socket-when-conne.patch	2024-05-08 21:21:50.000000000 +0800
+++ b/buildroot/package/wayland/0002-wayland-client-Support-waiting-for-socket-when-conne.patch	1970-01-01 08:00:00.000000000 +0800
@@ -1,47 +0,0 @@
-From c137da9fe3dd2c22908bd30e2812520e84615ec1 Mon Sep 17 00:00:00 2001
-From: Jeffy Chen <jeffy.chen@rock-chips.com>
-Date: Tue, 18 Jul 2023 10:33:55 +0800
-Subject: [PATCH 2/3] wayland-client: Support waiting for socket when
- connecting
-
-Set WAYLAND_WAIT=1 to enable it.
-
-Tested on RK3588 EVB with:
-1/ Run "weston-terminal&"
-2/ Run "WAYLAND_WAIT=1 weston&"
-
-Signed-off-by: Jeffy Chen <jeffy.chen@rock-chips.com>
----
- src/wayland-client.c | 9 ++++++++-
- 1 file changed, 8 insertions(+), 1 deletion(-)
-
-diff --git a/src/wayland-client.c b/src/wayland-client.c
-index 105f9be..ee00a98 100644
---- a/src/wayland-client.c
-+++ b/src/wayland-client.c
-@@ -1099,6 +1099,7 @@ connect_to_socket(const char *name)
- 	const char *runtime_dir;
- 	int name_size, fd;
- 	bool path_is_absolute;
-+	int i;
- 
- 	if (name == NULL)
- 		name = getenv("WAYLAND_DISPLAY");
-@@ -1151,7 +1152,13 @@ connect_to_socket(const char *name)
- 
- 	size = offsetof (struct sockaddr_un, sun_path) + name_size;
- 
--	if (connect(fd, (struct sockaddr *) &addr, size) < 0) {
-+	i = 500;
-+	while (connect(fd, (struct sockaddr *) &addr, size) < 0) {
-+		if (getenv("WAYLAND_WAIT") && i--) {
-+			usleep(10000);
-+			continue;
-+		}
-+
- 		close(fd);
- 		return -1;
- 	}
--- 
-2.20.1
-
diff -ruN a/buildroot/package/wayland/0003-client-Assign-proxy-to-default-queue-when-releasing-.patch b/buildroot/package/wayland/0003-client-Assign-proxy-to-default-queue-when-releasing-.patch
--- a/buildroot/package/wayland/0003-client-Assign-proxy-to-default-queue-when-releasing-.patch	2024-05-08 21:21:50.000000000 +0800
+++ b/buildroot/package/wayland/0003-client-Assign-proxy-to-default-queue-when-releasing-.patch	1970-01-01 08:00:00.000000000 +0800
@@ -1,74 +0,0 @@
-From bca20adea668af38cd639662955c69d44385b57a Mon Sep 17 00:00:00 2001
-From: Jeffy Chen <jeffy.chen@rock-chips.com>
-Date: Mon, 21 Aug 2023 18:19:40 +0800
-Subject: [PATCH 3/3] client: Assign proxy to default queue when releasing the
- attached one
-
-It's a bug to release a queue with proxies attached, but it doesn't
-deserve to die.
-
-Signed-off-by: Jeffy Chen <jeffy.chen@rock-chips.com>
----
- src/wayland-client.c | 32 +++++++++++++++++---------------
- 1 file changed, 17 insertions(+), 15 deletions(-)
-
-diff --git a/src/wayland-client.c b/src/wayland-client.c
-index ee00a98..cfca474 100644
---- a/src/wayland-client.c
-+++ b/src/wayland-client.c
-@@ -296,6 +296,21 @@ destroy_queued_closure(struct wl_closure *closure)
- 	wl_closure_destroy(closure);
- }
- 
-+static void
-+proxy_set_queue(struct wl_proxy *proxy, struct wl_event_queue *queue)
-+{
-+	wl_list_remove(&proxy->queue_link);
-+
-+	if (queue) {
-+		assert(proxy->display == queue->display);
-+		proxy->queue = queue;
-+	} else {
-+		proxy->queue = &proxy->display->default_queue;
-+	}
-+
-+	wl_list_insert(&proxy->queue->proxy_list, &proxy->queue_link);
-+}
-+
- static void
- wl_event_queue_release(struct wl_event_queue *queue)
- {
-@@ -316,9 +331,7 @@ wl_event_queue_release(struct wl_event_queue *queue)
- 				       proxy->object.interface->name,
- 				       proxy->object.id);
- 			}
--			proxy->queue = NULL;
--			wl_list_remove(&proxy->queue_link);
--			wl_list_init(&proxy->queue_link);
-+			proxy_set_queue(proxy, NULL);
- 		}
- 	}
- 
-@@ -2377,18 +2390,7 @@ WL_EXPORT void
- wl_proxy_set_queue(struct wl_proxy *proxy, struct wl_event_queue *queue)
- {
- 	pthread_mutex_lock(&proxy->display->mutex);
--
--	wl_list_remove(&proxy->queue_link);
--
--	if (queue) {
--		assert(proxy->display == queue->display);
--		proxy->queue = queue;
--	} else {
--		proxy->queue = &proxy->display->default_queue;
--	}
--
--	wl_list_insert(&proxy->queue->proxy_list, &proxy->queue_link);
--
-+	proxy_set_queue(proxy, queue);
- 	pthread_mutex_unlock(&proxy->display->mutex);
- }
- 
--- 
-2.20.1
-
